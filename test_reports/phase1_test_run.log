  private check8(v: boolean): void { this.check9(v); }
  private check9(v: boolean): void { this.check10(v); }
  
  private check10(v: boolean): void {
    this.checked = v;
    this.service020.method020();
  }
  
  build() {
    Checkbox()
      .select(this.checked)
      .onChange(this.onCheck)
  }
}

