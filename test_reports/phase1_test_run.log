@Component
struct Special_NestedCallbacks {
  private handleNestedCallbacks(): void {
    setTimeout(() => {
      setTimeout(() => {
        setTimeout(() => {
          setTimeout(() => {
            setTimeout(() => {
              console.log(  );
            }, 100);
          }, 100);
        }, 100);
      }, 100);
    }, 100);
  }
  
  private handlePromiseChain(): Promise<void> {
    return Promise.resolve()
      .then(() => console.log(  ))
      .then(() => console.log(  ))
      .then(() => console.log(  ))
      .then(() => console.log(  ))
      .then(() => console.log(  ));
  }
  
  build() {
    Button(  )
      .onClick(() => this.handleNestedCallbacks())
  }
}

